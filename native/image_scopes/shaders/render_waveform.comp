#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer Wave { uint density[]; }
w;
layout(binding = 1, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform PC {
    uint mode;  // 0 luma, 1 RGB overlay, 2 RGB parade (Rawr 17U fork)
    float gain;
    float opacity;
    uint showGrid;
    uint showBg;
    uint sampledPixels;
    uint reserved0;
    uint reserved1;
}
pc;

const uint PLANE_STRIDE = 131072u;  // 512*256

float rawBilinear(uint plane, vec2 q) {
    q = clamp(q, vec2(0.0), vec2(511.0, 255.0));
    ivec2 i0 = ivec2(floor(q));
    ivec2 i1 = min(i0 + ivec2(1), ivec2(511, 255));
    vec2 t = fract(q);
    float a = mix(float(w.density[plane * PLANE_STRIDE + uint(i0.y) * 512u + uint(i0.x)]),
                  float(w.density[plane * PLANE_STRIDE + uint(i0.y) * 512u + uint(i1.x)]), t.x);
    float b = mix(float(w.density[plane * PLANE_STRIDE + uint(i1.y) * 512u + uint(i0.x)]),
                  float(w.density[plane * PLANE_STRIDE + uint(i1.y) * 512u + uint(i1.x)]), t.x);
    return mix(a, b, t.y);
}

float horizontalPop(uint plane, vec2 q, float offset, vec4 bins) {
    vec2 shifted = clamp(q + vec2(offset, 0), vec2(0), vec2(511, 255));
    if (floor(shifted.x) != floor(q.x)) return rawBilinear(plane, shifted);
    vec2 t = fract(shifted);
    return mix(mix(bins.x, bins.y, t.x), mix(bins.z, bins.w, t.x), t.y);
}

float microPop(uint plane, vec2 q, float center, vec4 bins) {
    // Waveform X is source-image X. Keep horizontal reconstruction much
    // tighter than vertical reconstruction to preserve spatial topology.
    const float vy = .52;
    const float hx = .20;
    float c = center * .44;
    c += (rawBilinear(plane, q + vec2(0, vy)) + rawBilinear(plane, q - vec2(0, vy))) * .18;
    c += (horizontalPop(plane, q, hx, bins) + horizontalPop(plane, q, -hx, bins)) * .10;
    return c;
}
float mesoPop(uint plane, vec2 q, float center, vec4 bins) {
    const float vy = 1.10;
    const float hx = .28;
    float c = center * .48;
    c += (rawBilinear(plane, q + vec2(0, vy)) + rawBilinear(plane, q - vec2(0, vy))) * .18;
    c += (horizontalPop(plane, q, hx, bins) + horizontalPop(plane, q, -hx, bins)) * .08;
    return c;
}
float macroPop(uint plane, vec2 q, float center, vec4 bins) {
    const float vy = 1.85;
    const float hx = .38;
    float c = center * .56;
    c += (rawBilinear(plane, q + vec2(0, vy)) + rawBilinear(plane, q - vec2(0, vy))) * .16;
    c += (horizontalPop(plane, q, hx, bins) + horizontalPop(plane, q, -hx, bins)) * .06;
    return c;
}

float expResponse(float count, float scale) {
    if (count <= 0.0) return 0.0;
    return 1.0 - exp(-count / max(scale, 1e-5));
}

float renderPlane(uint plane, vec2 q) {
    ivec2 i0 = ivec2(floor(q));
    ivec2 i1 = min(i0 + ivec2(1), ivec2(511, 255));
    uint base = plane * PLANE_STRIDE;
    vec4 bins = vec4(w.density[base + uint(i0.y) * 512u + uint(i0.x)],
                     w.density[base + uint(i0.y) * 512u + uint(i1.x)],
                     w.density[base + uint(i1.y) * 512u + uint(i0.x)],
                     w.density[base + uint(i1.y) * 512u + uint(i1.x)]);
    vec2 t = fract(q);
    float center = mix(mix(bins.x, bins.y, t.x), mix(bins.z, bins.w, t.x), t.y);
    float micro = microPop(plane, q, center, bins);
    float meso = mesoPop(plane, q, center, bins);
    float macro = macroPop(plane, q, center, bins);

    // Normalize density by expected selected samples per source-X column rather
    // than by a scene-global peak. This lets sparse/medium/dense populations
    // coexist without making every occupied bin equally bright.
    float perColumn = max(float(pc.sampledPixels) / 512.0, 1.0);
    // Waveform E was visually tuned at FullReference where a 256x256
    // source yields 128 selected samples per presentation-X column.
    // Preserve those exact FullReference response scales, but scale them
    // linearly with the actual selected population. Fixed absolute floors
    // made Production50/25 progressively darker even when the measured
    // waveform geometry was identical.
    float sparseScale = perColumn * (.20 / 128.0);
    float mediumScale = perColumn * (1.50 / 128.0);
    float denseScale = perColumn * (8.0 / 128.0);

    float proxy = expResponse(micro, mediumScale);
    float wd = clamp((proxy - .42) / .42, 0.0, 1.0);
    float wm = clamp((proxy - .08) / .42, 0.0, 1.0) * (1.0 - wd);
    float ws = 1.0 - clamp(wm + wd, 0.0, 1.0);

    float c = ws * (.90 * micro + .10 * meso) + wm * (.58 * micro + .40 * meso + .02 * macro) +
              wd * (.38 * micro + .52 * meso + .10 * macro);

    float sparse = expResponse(c, sparseScale);
    float medium = expResponse(c, mediumScale);
    float dense = expResponse(c, denseScale);

    // Sparse confidence was the remaining sampling-dependent term. `c` scales
    // with selected population, so using it directly made Production25 darker
    // even after the exposure scales were normalized. Convert reconstructed
    // population back to the FullReference tuning population (128 samples/X
    // column for the qualification fixture) before evaluating confidence.
    //
    // At FullReference perColumn==128, this is exactly the original
    // clamp(c*.5) behavior, preserving the accepted Waveform E appearance.
    float fullReferenceEquivalentCount = c * (128.0 / perColumn);
    sparse *= .25 + .75 * clamp(fullReferenceEquivalentCount * .5, 0.0, 1.0);

    float light = .18 * sparse + .48 * medium + .82 * dense + .20 * pow(dense, 3.5);
    return clamp(pc.gain * (1.0 - exp(-light * 1.05)), 0.0, 1.0);
}

// Rawr 17U fork: translucent card (premultiplied: rgb is the light added over the viewfinder, alpha how much
// of the viewfinder it hides), dashed 0 / 50 / 100% lines, the top 2% of the scale (clipping) in the accent
// red, and a parade mode (R, G, B side by side). Consumers that ignore alpha see the same trace as before.
const float kCardAlpha = .45;
const vec3 kClipRed = vec3(.886, .204, .204);

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (any(greaterThanEqual(p, sz))) return;

    float level = 1.0 - (float(p.y) + .5) / float(sz.y);
    vec3 signal;
    if (pc.mode == 2u) {
        // parade: three panels, each the whole source width for one channel, 2 px apart
        int third = max(sz.x / 3, 1);
        int panel = min(p.x / third, 2);
        int lx = p.x - panel * third;
        if (lx < 1 || lx >= third - 1) {
            signal = vec3(0.0);
        } else {
            vec2 q = vec2((float(lx - 1) + .5) * 512.0 / float(third - 2), level * 256.0);
            q = clamp(q, vec2(0), vec2(511, 255));
            float d = renderPlane(uint(panel), q);
            vec3 tint = panel == 0 ? vec3(1.0, .42, .42) : (panel == 1 ? vec3(.45, 1.0, .55) : vec3(.48, .64, 1.0));
            signal = d * tint;
        }
    } else {
        vec2 q = vec2((float(p.x) + .5) * 512.0 / float(sz.x), level * 256.0);
        q = clamp(q, vec2(0), vec2(511, 255));
        if (pc.mode == 0u) {
            float d = renderPlane(0u, q);
            signal = vec3(d);
        } else {
            signal = vec3(renderPlane(0u, q), renderPlane(1u, q), renderPlane(2u, q));
        }
    }
    signal *= pc.opacity;
    // clipping: the top of the scale in the accent red
    if (level > .98) signal = kClipRed * max(signal.r, max(signal.g, signal.b));

    vec3 col = signal;
    float a = pc.showBg != 0u ? kCardAlpha : 0.0;
    if (pc.showGrid != 0u) {
        // dashed reference lines at 0, 50 and 100% (1 px, 6 px dash period)
        float yl[3] = float[3](0.0, .5, 1.0);
        for (int k = 0; k < 3; ++k) {
            int y = clamp(int(round((1.0 - yl[k]) * float(sz.y - 1))), 0, sz.y - 1);
            if (p.y == y && (p.x / 3) % 2 == 0) col = max(col, vec3(k == 1 ? .16 : .24));
        }
    }
    float m = max(col.r, max(col.g, col.b));
    a = clamp(a + (1.0 - a) * m, 0.0, 1.0);
    imageStore(dst, p, vec4(clamp(col, 0.0, 1.0), a));
}
